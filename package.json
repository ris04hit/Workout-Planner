{
  "name": "workout-planner",
  "version": "1.0.0",
  "description": "Workout Planner Application",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleFileExtensions": ["js"],
    "testMatch": ["**/tests/static/js/**/*.test.js"],
    "setupFilesAfterEnv": ["<rootDir>/tests/static/js/setup.js"],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/static/js/$1"
    }
  }
}
